# Local development only. Change this before exposing MySQL outside your machine.
MYSQL_ROOT_PASSWORD=clinic_dev_root
# Development credentials only; replace before any shared deployment.
IDENTITY_ADMIN_USERNAME=admin
IDENTITY_ADMIN_PASSWORD=DevAdminChangeMe123!
IDENTITY_JWT_SECRET=replace_this_local_development_signing_secret_before_deployment
IDENTITY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REGISTRY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SCHEDULING_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Shared only by Identity and Registry; use a new random secret outside local development.
REGISTRY_INTERNAL_TOKEN=replace_this_internal_service_token_before_deployment
# Shared only by Scheduling and Appointment; replace before shared deployment.
SCHEDULING_INTERNAL_TOKEN=replace_this_scheduling_internal_token_before_deployment
SCHEDULING_HOLD_TTL_SECONDS=600
APPOINTMENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APPOINTMENT_RECONCILE_INTERVAL_SECONDS=30
APPOINTMENT_RECONCILE_MIN_AGE_SECONDS=30
APPOINTMENT_RECONCILE_BATCH_SIZE=20
# Shared by Appointment and Billing for server-to-server payment checks.
BILLING_INTERNAL_TOKEN=replace_this_billing_internal_token_before_deployment
LABORATORY_INTERNAL_TOKEN=replace_this_laboratory_internal_token_before_deployment
BILLING_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLINICAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LABORATORY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
